#!/usr/bin/env python3

"""Report whether an OCF compute node is ready to execute CUDA jobs."""

import argparse
import ctypes
import glob
import json
import os
import shutil
import stat
import subprocess
import sys


def check(name, ready, detail, required=True):
    return {
        'name': name,
        'ready': bool(ready),
        'required': required,
        'detail': detail,
    }


def run(command, timeout=10):
    return subprocess.run(
        command,
        check=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        timeout=timeout,
        universal_newlines=True,
    )


def nvidia_smi_check():
    command = shutil.which('nvidia-smi')
    if not command:
        return check('nvidia_smi', False, 'nvidia-smi is not installed')

    try:
        result = run([
            command,
            '--query-gpu=index,name,uuid,driver_version',
            '--format=csv,noheader,nounits',
        ])
    except (subprocess.CalledProcessError, subprocess.TimeoutExpired) as ex:
        detail = getattr(ex, 'stderr', '') or str(ex)
        return check('nvidia_smi', False, detail.strip())

    gpus = []
    for line in result.stdout.splitlines():
        fields = [field.strip() for field in line.split(',', 3)]
        if len(fields) == 4:
            gpus.append({
                'index': fields[0],
                'name': fields[1],
                'uuid': fields[2],
                'driver_version': fields[3],
            })

    if not gpus:
        return check('nvidia_smi', False, 'nvidia-smi reported no GPUs')
    return check('nvidia_smi', True, {'gpus': gpus, 'count': len(gpus)})


def kernel_module_check(name):
    path = '/sys/module/{}'.format(name)
    return check(
        'module_{}'.format(name),
        os.path.isdir(path),
        '{} is {}loaded'.format(name, '' if os.path.isdir(path) else 'not '),
    )


def character_device_check(path, required=True):
    try:
        is_device = stat.S_ISCHR(os.stat(path).st_mode)
    except OSError as ex:
        return check(
            'device_{}'.format(os.path.basename(path)),
            False,
            str(ex),
            required=required,
        )

    return check(
        'device_{}'.format(os.path.basename(path)),
        is_device,
        '{} is {}a character device'.format(path, '' if is_device else 'not '),
        required=required,
    )


def gpu_device_check():
    paths = [
        path for path in glob.glob('/dev/nvidia[0-9]*')
        if os.path.basename(path)[6:].isdigit()
    ]
    character_devices = []
    for path in paths:
        try:
            if stat.S_ISCHR(os.stat(path).st_mode):
                character_devices.append(path)
        except OSError:
            pass

    return check(
        'gpu_devices',
        bool(character_devices),
        {'paths': sorted(character_devices), 'count': len(character_devices)},
    )


def cuda_error_name(driver, status):
    name = ctypes.c_char_p()
    try:
        if driver.cuGetErrorName(status, ctypes.byref(name)) == 0 and name.value:
            return name.value.decode('ascii', errors='replace')
    except AttributeError:
        pass
    return 'CUDA_ERROR_{}'.format(status)


def cuda_driver_check(loader=None):
    if loader is None:
        loader = ctypes.CDLL

    try:
        driver = loader('libcuda.so.1')
    except OSError as ex:
        return check('cuda_driver_api', False, str(ex))

    status = driver.cuInit(0)
    if status != 0:
        return check(
            'cuda_driver_api',
            False,
            'cuInit failed: {}'.format(cuda_error_name(driver, status)),
        )

    count = ctypes.c_int()
    status = driver.cuDeviceGetCount(ctypes.byref(count))
    if status != 0:
        return check(
            'cuda_driver_api',
            False,
            'cuDeviceGetCount failed: {}'.format(cuda_error_name(driver, status)),
        )

    return check(
        'cuda_driver_api',
        count.value > 0,
        {'device_count': count.value},
    )


def package_diagnostics():
    command = shutil.which('dpkg-query')
    if not command:
        return {'available': False, 'packages': []}

    try:
        result = run([
            command,
            '-W',
            '-f=${binary:Package}\t${Version}\n',
            'nvidia-*',
            'libnvidia-*',
        ])
    except (subprocess.CalledProcessError, subprocess.TimeoutExpired) as ex:
        output = getattr(ex, 'stdout', '') or ''
    else:
        output = result.stdout

    packages = []
    for line in output.splitlines():
        fields = line.split('\t', 1)
        if len(fields) == 2:
            packages.append({'name': fields[0], 'version': fields[1]})
    return {'available': True, 'packages': packages}


def evaluate(checks):
    return all(item['ready'] for item in checks if item['required'])


def probe():
    checks = [
        nvidia_smi_check(),
        kernel_module_check('nvidia'),
        kernel_module_check('nvidia_uvm'),
        character_device_check('/dev/nvidiactl'),
        character_device_check('/dev/nvidia-uvm'),
        character_device_check('/dev/nvidia-uvm-tools', required=False),
        gpu_device_check(),
        cuda_driver_check(),
    ]
    return {
        'schema_version': 1,
        'ready': evaluate(checks),
        'checks': checks,
        'diagnostics': {
            'kernel_release': os.uname().release,
            'packages': package_diagnostics(),
        },
    }


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        '--compact',
        action='store_true',
        help='write JSON on one line',
    )
    args = parser.parse_args()

    report = probe()
    indent = None if args.compact else 2
    print(json.dumps(report, indent=indent, sort_keys=True))
    return 0 if report['ready'] else 1


if __name__ == '__main__':
    sys.exit(main())
